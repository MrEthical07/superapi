# SuperAPI environment
#
# Copy to .env (`cp .env.example .env`). Make targets (run, user, migrate-*,
# perf-token) source .env automatically; `go run ./cmd/api` does not, so export
# the variables yourself when running binaries directly.
#
# Values below match docker-compose.yml (`make dev-up`). Commented lines show
# the default. Every variable the code reads is listed here; see
# docs/environment-variables.md for details and lint rules.

# ==========================================================================
# App
# ==========================================================================
# APP_PROFILE=            # optional preset: minimal | dev | prod
# dev | test | staging | prod
APP_ENV=dev
# APP_SERVICE_NAME=api-template

# ==========================================================================
# HTTP server
# ==========================================================================
HTTP_ADDR=:8080
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=10s
# HTTP_MAX_HEADER_BYTES=1048576
# HTTP_TRUSTED_PROXIES=   # comma-separated IPs/CIDRs allowed to set X-Forwarded-For

# Global middleware
# HTTP_MIDDLEWARE_REQUEST_ID_ENABLED=true
# HTTP_MIDDLEWARE_RECOVERER_ENABLED=true
# HTTP_MIDDLEWARE_MAX_BODY_BYTES=1048576
# HTTP_MIDDLEWARE_SECURITY_HEADERS_ENABLED=   # default: true in prod, false otherwise
# HTTP_MIDDLEWARE_REQUEST_TIMEOUT=0s
# HTTP_MIDDLEWARE_TRACING_EXCLUDE_PATHS=/healthz,/readyz,/metrics
# HTTP_MIDDLEWARE_ACCESS_LOG_ENABLED=true
# HTTP_MIDDLEWARE_ACCESS_LOG_SAMPLE_RATE=0.05
# HTTP_MIDDLEWARE_ACCESS_LOG_EXCLUDE_PATHS=/healthz,/readyz,/metrics
# HTTP_MIDDLEWARE_ACCESS_LOG_SLOW_THRESHOLD=2s
# HTTP_MIDDLEWARE_ACCESS_LOG_INCLUDE_USER_AGENT=false
# HTTP_MIDDLEWARE_ACCESS_LOG_INCLUDE_REMOTE_IP=false
# HTTP_MIDDLEWARE_CORS_ENABLED=false
# HTTP_MIDDLEWARE_CORS_ALLOW_ORIGINS=
# HTTP_MIDDLEWARE_CORS_DENY_ORIGINS=
# HTTP_MIDDLEWARE_CORS_ALLOW_METHODS=
# HTTP_MIDDLEWARE_CORS_ALLOW_HEADERS=
# HTTP_MIDDLEWARE_CORS_EXPOSE_HEADERS=
# HTTP_MIDDLEWARE_CORS_ALLOW_CREDENTIALS=false
# HTTP_MIDDLEWARE_CORS_MAX_AGE=0s
# HTTP_MIDDLEWARE_CORS_ALLOW_PRIVATE_NETWORK=false

# ==========================================================================
# Logging
# ==========================================================================
# LOG_LEVEL=info          # debug | info | warn | error
# json (default) | text
LOG_FORMAT=text

# ==========================================================================
# Postgres (docker-compose.yml credentials)
# ==========================================================================
POSTGRES_ENABLED=true
POSTGRES_URL=postgres://superapi:superapi@127.0.0.1:5432/superapi?sslmode=disable
# POSTGRES_MAX_CONNS=10
# POSTGRES_MIN_CONNS=0
# POSTGRES_CONN_MAX_LIFETIME=30m
# POSTGRES_CONN_MAX_IDLE_TIME=5m
# POSTGRES_STARTUP_PING_TIMEOUT=3s
# POSTGRES_HEALTH_CHECK_TIMEOUT=1s

# ==========================================================================
# Redis
# ==========================================================================
REDIS_ENABLED=true
REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_DIAL_TIMEOUT=2s
# REDIS_READ_TIMEOUT=2s
# REDIS_WRITE_TIMEOUT=2s
# REDIS_POOL_SIZE=10
# REDIS_MIN_IDLE_CONNS=0
# REDIS_STARTUP_PING_TIMEOUT=3s
# REDIS_HEALTH_CHECK_TIMEOUT=1s

# ==========================================================================
# Auth (goAuth) — requires Postgres and Redis
# ==========================================================================
AUTH_ENABLED=true
# jwt_only | hybrid | strict
AUTH_MODE=hybrid
# AUTH_MAX_SESSION_DURATION=        # absolute session ceiling, e.g. 720h
# AUTH_LIMITER_WINDOW_MODE=fixed    # fixed | sliding
# AUTH_KEY_ID=                      # active signing kid (required with AUTH_VERIFY_KEYS)
# AUTH_VERIFY_KEYS=                 # kid=<ed25519-pem>,... for key rotation

# Optional auth endpoint groups (all off by default; see docs/auth-flows.md)
# AUTH_REGISTRATION_ENABLED=false
# AUTH_REGISTRATION_AUTO_LOGIN=false      # trades away registration enumeration resistance
# AUTH_PASSWORD_RESET_ENABLED=false
# AUTH_EMAIL_VERIFICATION_ENABLED=false
# AUTH_EMAIL_VERIFICATION_REQUIRED=true   # block login until verified
# AUTH_TOTP_ENABLED=false
# AUTH_TOTP_ISSUER=                       # defaults to APP_SERVICE_NAME
# AUTH_TOTP_ENCRYPTION_KEY=               # required with TOTP: `openssl rand -base64 32`

# WebAuthn (scaffolded, off by default; see docs/enabling-webauthn.md)
# WEBAUTHN_ENABLED=false
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_DISPLAY_NAME=SuperAPI
# WEBAUTHN_RP_ORIGINS=http://localhost:3000
# WEBAUTHN_ATTESTATION_PREFERENCE=none
# WEBAUTHN_USER_VERIFICATION=preferred
# WEBAUTHN_CEREMONY_TTL=2m
# WEBAUTHN_REQUIRE_FOR_LOGIN=false
# WEBAUTHN_REJECT_CLONED_AUTHENTICATORS=true

# Delivery of password-reset / email-verification secrets
# NOTIFY_DRIVER=noop        # noop | log (development)
# NOTIFY_LOG_SECRETS=false  # log full secrets; only allowed with APP_ENV=dev
# NOTIFY_TIMEOUT=10s

# ==========================================================================
# Multi-tenancy (off by default; see docs/multi-tenancy.md)
# ==========================================================================
# TENANCY_ENABLED=false
# TENANCY_RESOLVER=header           # header | subdomain
# TENANCY_HEADER=X-Tenant-ID
# TENANCY_BASE_DOMAIN=              # required for subdomain: acme.example.com -> acme
# TENANCY_VALIDATE=true             # tenant must exist in `tenants` and be active
# TENANCY_VALIDATE_CACHE_TTL=30s
# TENANCY_EXEMPT_PATHS=/healthz,/readyz,/metrics

# ==========================================================================
# Rate limiting and response cache (Redis)
# ==========================================================================
RATELIMIT_ENABLED=true
# must be false in prod
RATELIMIT_FAIL_OPEN=true
# RATELIMIT_DEFAULT_LIMIT=10
# RATELIMIT_DEFAULT_WINDOW=1m
CACHE_ENABLED=true
# must be false in prod
CACHE_FAIL_OPEN=true
# CACHE_DEFAULT_MAX_BYTES=262144
# CACHE_TAG_VERSION_CACHE_TTL=250ms

# ==========================================================================
# Observability
# ==========================================================================
# METRICS_ENABLED=true
# METRICS_PATH=/metrics
# METRICS_AUTH_TOKEN=               # required in prod when metrics are enabled
# METRICS_EXCLUDE_PATHS=/healthz,/readyz
# TRACING_ENABLED=false
# TRACING_SERVICE_NAME=             # defaults to APP_SERVICE_NAME
# TRACING_EXPORTER=otlpgrpc
# TRACING_OTLP_ENDPOINT=localhost:4317
# TRACING_SAMPLER=traceidratio
# TRACING_SAMPLE_RATIO=0.05
# TRACING_INSECURE=                 # default: true outside prod

# ==========================================================================
# Performance testing only (refused unless APP_ENV=dev or test)
# ==========================================================================
# AUTH_TEST_SHARED_SECRET=
# AUTH_TEST_ACCESS_TTL=
# AUTH_TEST_REFRESH_TTL=
